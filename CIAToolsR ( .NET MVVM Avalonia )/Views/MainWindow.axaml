<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CIAToolsR.ViewModels"
        xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia" 
        Width="600" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        x:Class="CIAToolsR.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding Current_os, StringFormat='CIAToolsR - {0}.V10.0.0'}"
        DragDrop.AllowDrop="True"

        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        TransparencyBackgroundFallback="#1A1A1E">

    <Window.Resources>
        <FontFamily x:Key="Montserrat.Extrabold">avares://CIAToolsR/Assets/Fonts/Montserrat-ExtraBold.ttf</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="Orange" SecondaryColor="Purple" />
        <materialIcons:MaterialIconStyles />

        <Style Selector="Border.drop-zone">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.drop-zone:pointerover">
            <Setter Property="Background" Value="#25FF9E00"/>
            <Setter Property="BorderBrush" Value="#FF9E00"/>
        </Style>

        <Style Selector="Button.btn-build">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontFamily" Value="{StaticResource Montserrat.Extrabold}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="Base" Background="#FF9E00" CornerRadius="8" BoxShadow="0 4 12 0 #50FF9E00"/>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.btn-build:pointerover /template/ Border#Base">
            <Setter Property="Background" Value="#FFAA1A"/>
        </Style>

        <Style Selector="Button.btn-cancel">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="Base" Background="#2A2A32" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8"/>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.btn-cancel:pointerover /template/ Border#Base">
            <Setter Property="Background" Value="#3A3A45"/>
        </Style>

        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Styles>

    <Border Background="#B0141418" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="70, *, 36">
            
            <!-- HEADER -->
            <Grid Grid.Row="0">
                <TextBlock Text="CIATools" 
                           FontSize="36" 
                           Foreground="White"
                           FontFamily="{StaticResource Montserrat.Extrabold}" 
                           FontWeight="ExtraBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           PointerPressed="OnOpenGitHubPointerPressed"/>

                <Rectangle Height="1" Fill="#20FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="25,0"/>
            </Grid>

            <!-- ZONE CENTRALE (ROW 1) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- 1. DRAG & DROP PANEL -->
                <Border Name="DropZonePanel" 
                        Classes="drop-zone" 
                        Height="220" 
                        Width="480"
                        Cursor="Hand"
                        DragDrop.AllowDrop="True"
                        PointerPressed="OnDropZoneClick"
                        IsVisible="{Binding IsDropZoneVisible}">
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <materialIcons:MaterialIcon Kind="FileUpload" IconSize="48" Foreground="#FF9E00"/>
                        <TextBlock Text="Drag &amp; Drop files here" 
                                   Foreground="White" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse" 
                                   Foreground="#888888" 
                                   FontSize="12" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 2. PANNEAU DE CONFIRMATION -->
                <Border Name="ConfirmationPanel" 
                        Background="#20FFFFFF" 
                        BorderBrush="#FF9E00" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20" 
                        Height="170" 
                        Width="320"
                        IsVisible="{Binding IsConfirmationVisible}">
                    
                    <StackPanel VerticalAlignment="Center" Spacing="12">
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CheckCircleOutline" IconSize="22" Foreground="#30D158"/>
                            <TextBlock Text="Files imported" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock Text="Build homebrew as a CIA file?" 
                                   Foreground="#CCCCCC" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>

                        <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                            <Button Grid.Column="0" 
                                    Classes="btn-cancel" 
                                    Content="CANCEL" 
                                    Command="{Binding ClearUserFilesCommand}" 
                                    Height="38" 
                                    Margin="0,0,5,0"/>

                            <Button Grid.Column="1" 
                                    Classes="btn-build" 
                                    Content="BUILD" 
                                    Command="{Binding BuildCommand}" 
                                    Height="38" 
                                    Margin="5,0,0,0"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- 3. PANNEAU DE CHARGEMENT (COMPILING) -->
                <Border Name="LoadingPanel" 
                        Background="#20FFFFFF" 
                        BorderBrush="#FF9E00" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20" 
                        Height="170" 
                        Width="320"
                        IsVisible="{Binding IsBuilding}">
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        
                        <materialIcons:MaterialIcon Kind="CogSync" IconSize="40" Foreground="#FF9E00"/>
                        
                        <TextBlock Text="Compiling to CIA..." 
                                   Foreground="White" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>

                        <!-- Barre de chargement animée -->
                        <ProgressBar IsIndeterminate="True" 
                                     Width="200" 
                                     Height="4" 
                                     Foreground="#FF9E00" 
                                     Background="#30FFFFFF"
                                     CornerRadius="2"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- FOOTER (ROW 2) -->
            <Border Grid.Row="2" Background="#30000000" CornerRadius="0,0,10,10" Padding="15,0">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" 
                               Text="{Binding Debug_output, StringFormat='Console - {0}'}" 
                               Foreground="#888888" 
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Console}"/>

                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Right" 
                                Spacing="4">
                        
                        <Menu>
                            <MenuItem ToolTip.Tip="Tools">
                                <MenuItem.Header>
                                    <materialIcons:MaterialIcon Kind="WrenchOutline" IconSize="20" Foreground="#A0A0A0"/>
                                </MenuItem.Header>
                                <MenuItem Header="_Clean USER_FILES" Click="OnClearMenuClick"/>
                                <MenuItem Header="_Restore AUTHOR.txt" Click="OnRestoreAuthor"/>
                                <MenuItem Header="_Restore FILE_PATH" Click="OnRestoreFILEPATH"/>
                                <Separator/>
                                <CheckBox Content="Console" IsChecked="{Binding Console}"/>
                                <CheckBox Content="Auto Close Script" IsChecked="{Binding AutoCloseScript}"/>
                            </MenuItem>
                        </Menu>

                        <Menu>
                            <MenuItem ToolTip.Tip="Create">
                                <MenuItem.Header>
                                    <materialIcons:MaterialIcon Kind="TuneVariant" IconSize="20" Foreground="#A0A0A0"/>
                                </MenuItem.Header>
                                <MenuItem Header="_Start RSF-Creator" Click="OnRSFCREATOR"/>
                                <MenuItem Header="_Start SMDH-Creator" Click="OnSMDHCREATOR"/>
                                <Separator/>
                                <MenuItem Header="_Set Author name" Click="OnSetAuthorName"/>
                            </MenuItem>
                        </Menu>

                        <Menu>
                            <MenuItem ToolTip.Tip="Help">
                                <MenuItem.Header>
                                    <materialIcons:MaterialIcon Kind="HelpCircleOutline" IconSize="20" Foreground="#A0A0A0"/>
                                </MenuItem.Header>
                                <MenuItem Header="_Github" Click="OnOpenGitHubClick"/>
                                <MenuItem Header="_Discord" Click="OnOpenDiscord"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>