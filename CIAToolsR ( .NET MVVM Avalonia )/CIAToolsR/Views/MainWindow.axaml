<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CIAToolsR.ViewModels"
        xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia" 
        MinHeight="400" MinWidth="600" MaxHeight="400" MaxWidth="600"
        x:Class="CIAToolsR.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding Current_os, StringFormat='CIAToolsR - {0}.V9.0.0'}"
        DragDrop.AllowDrop="True"

        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF1E1E1E">

    
    <Window.Resources>
        <FontFamily x:Key="Montserrat.Extrabold">avares://CIAToolsR/Assets/Fonts/Montserrat-ExtraBold.ttf</FontFamily>
    </Window.Resources>
    
<Window.Styles>
    <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="Orange" SecondaryColor="Purple" />
    <materialIcons:MaterialIconStyles />

    <Style Selector="Button.neon-blue">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Background="#ff9e00"
                            CornerRadius="7"
                            BoxShadow="0 0 15 0 #ff9e00"/> <Border Name="HoverGlow"
                            Background="Transparent"
                            CornerRadius="7"
                            BoxShadow="0 0 12 0 #ff9e00, 0 0 25 -3 #ff9e00, 0 0 50 -8 #ff9e00"
                            Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.neon-blue:pointerover /template/ Border#HoverGlow">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.neon-purple">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Background="#240046"
                            CornerRadius="7"
                            BoxShadow="0 0 15 0 #240046"/>
                    
                    <Border Name="HoverGlow"
                            Background="Transparent"
                            CornerRadius="7"
                            BoxShadow="0 0 12 0 #9D00FF, 0 0 25 -3 #9D00FF, 0 0 50 -8 #9D00FF"
                            Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.neon-purple:pointerover /template/ Border#HoverGlow">
        <Setter Property="Opacity" Value="1"/>
    </Style>
</Window.Styles>
    
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="#CC000000">
        <Image Source="/Assets/background.png"
               Stretch="UniformToFill"
               Opacity="0.5"/>
        <Canvas>

            <TextBlock Text="CIATools" 
                       Canvas.Left="205" 
                       Canvas.Top="-1.5" 
                       FontSize="45" 
                       Foreground="White"
                       FontFamily="{StaticResource Montserrat.Extrabold}" 
                       FontWeight="ExtraBold"
                       Cursor="Hand"
                       PointerPressed="OnOpenGitHubPointerPressed"/>

            <Menu Canvas.Top="120" Canvas.Left="0" Background="Transparent">
                <MenuItem>
                    <MenuItem.Header>
                        <materialIcons:MaterialIcon Kind="Tools" IconSize="45" />
                    </MenuItem.Header>
                    <MenuItem Header="_Clean USER_FILES" Click="OnClearMenuClick"/>
                    <MenuItem Header="_Restore AUTHOR.txt" Click="OnRestoreAuthor"/>
                    <MenuItem Header="_Restore FILE_PATH" Click="OnRestoreFILEPATH"/>
                    <CheckBox Content=" - Console" IsChecked="{Binding Console}"/>
                    <CheckBox Content=" - Auto Close Script" IsChecked="{Binding AutoCloseScript}"/>
                </MenuItem>
            </Menu>

            <Menu Canvas.Top="187" Canvas.Left="0" Background="Transparent">
                <MenuItem>
                    <MenuItem.Header>
                        <materialIcons:MaterialIcon Kind="TuneVariant" IconSize="50" />
                    </MenuItem.Header>
                    <MenuItem Header="_Start RSF-Creator" Click="OnRSFCREATOR"/>
                    <MenuItem Header="_Start SMDH-Creator" Click="OnSMDHCREATOR"/>
					<MenuItem Header="_Set Author name" Click="OnSetAuthorName"/>
                </MenuItem>
            </Menu>

            <Menu Canvas.Top="255" Canvas.Left="0" Background="Transparent">
                <MenuItem>
                    <MenuItem.Header>
                        <materialIcons:MaterialIcon Kind="HelpCircleOutline" IconSize="50" />
                    </MenuItem.Header>
                    <MenuItem Header="_Github" Click="OnOpenGitHubClick"/>
					<MenuItem Header="_Discord" Click="OnOpenDiscord"/>
                </MenuItem>
            </Menu>
            

            <Line StartPoint="0,65" EndPoint="700,65" Stroke="White" StrokeThickness="3">
                <Line.Effect>
                    <BlurEffect Radius="2" />
                </Line.Effect>
                <Line.Styles>
                    <Style Selector="Line">
                        <Style.Animations>
                            <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate">
                                <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
                                <KeyFrame KeyTime="0:0:1.5"><Setter Property="Opacity" Value="0.5"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Line.Styles>
            </Line>
            
            <Button Classes="neon-blue" Content="BUILD CIA" Command="{Binding BuildCommand}" Canvas.Left="180" Canvas.Top="120" Width="255" Height="120" FontSize="24"/>
            <Button Classes="neon-purple" Content="IMPORT" Click="ImportFiles" Canvas.Left="180" Canvas.Top="250" Width="255" Height="50"/>            
            <TextBlock Text="{Binding Debug_output, StringFormat='Console - {0}'}" Canvas.Left="5" Canvas.Top="370" Foreground="White" IsVisible="{Binding Console}"/>
        </Canvas>
    </Grid>
</Window>