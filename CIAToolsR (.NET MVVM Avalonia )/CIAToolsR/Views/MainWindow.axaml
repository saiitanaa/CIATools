<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CIAToolsR.ViewModels"
        xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia" 
        MinHeight="370" MinWidth="440" MaxHeight="370" MaxWidth="440"
        x:Class="CIAToolsR.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding Current_os, StringFormat='CIAToolsR - {0}.V6'}">

    <Window.Resources>
        <FontFamily x:Key="Montserrat.Extrabold">avares://CIAToolsR/Assets/Fonts/Montserrat-ExtraBold.ttf</FontFamily>
    </Window.Resources>
    
    <Window.Styles>
        <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="Orange" SecondaryColor="Pink" />
        <materialIcons:MaterialIconStyles />
    </Window.Styles>
    
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Image Source="/Assets/background.png" Stretch="UniformToFill" Opacity="0.5"/>

        <Canvas>
            <TextBlock Text="CIATools" Canvas.Left="108" Canvas.Top="2" FontSize="40" FontFamily="{StaticResource Montserrat.Extrabold}" FontWeight="ExtraBold"/>
            <Menu Canvas.Top="6" Canvas.Left="285" Background="Transparent">
                <MenuItem>
                    <MenuItem.Header>
                        <materialIcons:MaterialIcon Kind="Tools" IconSize="38" />
                    </MenuItem.Header>
                    <MenuItem Header="_Clean USER_FILES" Click="OnClearMenuClick"/>
                    <CheckBox Content=" - Console" IsChecked="{Binding Console}"/>
                    <CheckBox Content=" - Auto Close Script" IsChecked="{Binding AutoCloseScript}"/>
                    <MenuItem Header="_Install Python dependencies" Command="{Binding PyDependenciesCommand}"/>
                </MenuItem>
            </Menu>
            
            <Line StartPoint="0,65" EndPoint="500,65" Stroke="GhostWhite" StrokeThickness="3">
                <Line.Effect>
                    <BlurEffect Radius="4" />
                </Line.Effect>
                <Line.Styles>
                    <Style Selector="Line">
                        <Style.Animations>
                            <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate">
                                <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                                <KeyFrame KeyTime="0:0:1.5"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Line.Styles>
            </Line>
            
            <Button Content="Build CIA" Command="{Binding BuildCommand}" Canvas.Left="115" Canvas.Top="120" FontSize="25" Width="210" Height="100" Background="SeaGreen" Foreground="White"/>
            <Button Content="Import" Click="ImportFiles" Canvas.Left="115" Canvas.Top="230" FontSize="25" Width="210" Height="50" Background="DarkSlateGray" Foreground="White"/>
            <TextBlock Text="{Binding Debug_output, StringFormat='Console - {0}'}" Canvas.Left="5" Canvas.Top="340" Foreground="Yellow" IsVisible="{Binding Console}"/>
        </Canvas>
    </Grid>
</Window>